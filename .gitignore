# `a/` is the archived, superseded version-A build — not part of the current site.
a/

# Local safety copies made before surgical edits (safe-artifact-stewardship). Not history.
*.bak
*.bak-*
*.bak-precanon

# Deployment credentials and runtime backups never belong in an installable
# or evaluator-facing branch, even when encrypted.
beta/secrets/*.enc
beta/secrets/*.tar.gz
beta/secrets/*.json
beta/secrets/*.pem
beta/secrets/*.key
