        "id": "report-snapshot",
        "timeout_sec": 60,
        "type": "programmatic"
      },
      {
        "check": [
          "node",
          "../../tools/coordination/check-coordination-report.mjs",
          "loop-workspace/coordination-report.md"
        ],
        "expect": "exit_zero",
        "id": "report-safe",
        "timeout_sec": 60,
        "type": "programmatic"
      },
      {
        "check": [
          "node",
          "--test",
