    "verification": [
      {
        "check": [
          "node",
          "../../tools/coordination/validate-board.mjs",
          "--board-only"
        ],
        "expect": "exit_zero",
        "id": "board-valid",
        "timeout_sec": 60,
        "type": "programmatic"
      },
      {
        "check": [
          "node",
          "../../tools/coordination/watch-agent-reports.mjs",
          "--once"
