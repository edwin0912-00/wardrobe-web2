{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.ai/schemas/asset-manifest.schema.json",
  "title": "Zeely Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "environment_policy", "assets", "consent"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "job_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{8,80}$" },
    "environment_policy": { "enum": ["ORG_PRESERVE", "DIFF_REPLACE"] },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_likeness_authorized", "commercial_use_authorized", "recorded_at"],
      "properties": {
        "human_likeness_authorized": { "type": "boolean" },
        "commercial_use_authorized": { "type": "boolean" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "evidence_uri": { "type": ["string", "null"], "format": "uri-reference" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id", "kind", "role", "source_uri", "sha256", "mime_type",
        "width", "height", "status", "facts", "locks"
      ],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{4,80}$" },
        "kind": { "enum": ["HUMAN", "PRODUCT", "GARMENT", "ENVIRONMENT", "STYLE", "POSE", "MOTION", "AUDIO", "LOGO"] },
        "role": { "enum": ["PRIMARY", "FRONT", "BACK", "THREE_QUARTER", "DETAIL", "FULL_BODY", "FACE", "MASK", "REFERENCE", "TARGET"] },
        "source_uri": { "type": "string", "format": "uri-reference" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mime_type": { "type": "string", "pattern": "^(image|video|audio)/" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["PASS", "REPAIRABLE", "REJECT"] },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blur": { "type": "number", "minimum": 0, "maximum": 1 },
            "exposure": { "type": "number", "minimum": 0, "maximum": 1 },
            "occlusion": { "type": "number", "minimum": 0, "maximum": 1 },
            "subject_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value", "provenance", "confidence"],
            "properties": {
              "key": { "type": "string" },
              "value": {},
              "provenance": { "enum": ["OBSERVED", "USER_PROVIDED", "UNKNOWN"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "bbox_xywh": {
                "type": ["array", "null"],
                "prefixItems": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "number", "minimum": 0, "maximum": 1 }
                ],
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        "locks": {
          "type": "array",
          "items": {
            "enum": [
              "IDENTITY", "FACE_GEOMETRY", "HAIR", "BODY_PROPORTIONS", "SKU_GEOMETRY",
              "GARMENT_STRUCTURE", "LOGO", "TEXT", "COLOR", "MATERIAL", "ENVIRONMENT_LAYOUT",
              "CAMERA", "LIGHTING", "STYLE"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
