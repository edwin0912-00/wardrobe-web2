{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.ai/schemas/motion-modes.schema.json",
  "title": "Zeely Motion Modes",
  "$comment": "The catalogue that satisfies the ALLOWED_PRESET_ONLY gate of node VIDEO.02. A caller picks a mode id and nothing else: the model, the delivery geometry and the reference roles are all read from here, so a request cannot name its own model. Validated at load, the same way config/post-shoot-pipeline.json is.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "route_policy", "modes"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "catalog_id": { "const": "zeely.motion-modes.v1" },
    "status": { "enum": ["DRAFT_FOR_APPROVAL", "READY"] },
    "route_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "audio_policy", "aspect_policy"],
      "properties": {
        "transport": {
          "const": "MCP",
          "description": "Higgsfield and Magnific are reached over MCP only. A mode may not declare any other transport."
        },
        "note": { "type": "string" },
        "audio_policy": {
          "const": "MODEL_AUDIO_NEVER_SHIPS",
          "description": "Both routed models invented an audio track when none was asked for, and it tends to the stock sound the operator has forbidden."
        },
        "aspect_policy": { "const": "DELIVERY_ASPECT_IS_A_ROUTE_PARAMETER_NEVER_PROMPT_PROSE" }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mode" }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "billable", "scene_kind", "route", "delivery", "shot_list", "reference_roles", "audio"],
      "properties": {
        "id": { "type": "string", "pattern": "^motion\\.[a-z_]+\\.[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 10 },
        "billable": {
          "const": true,
          "description": "Every motion generation is paid. A free motion mode does not exist, and declaring one would let a caller reach a paid provider through an unpriced door."
        },
        "scene_kind": { "enum": ["standard_background", "art_fashion_shoot"] },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_slug"],
          "properties": {
            "model_slug": { "enum": ["bytedance-seedance-pro-2.0", "gemini-omni-preview"] }
          },
          "description": "No transport field: the catalogue's route_policy already fixes it at MCP for every mode."
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aspect_ratio", "duration_seconds", "resolution"],
          "properties": {
            "aspect_ratio": { "const": "9:16" },
            "duration_seconds": { "type": "integer", "minimum": 3, "maximum": 15 },
            "resolution": { "enum": ["720p", "1080p"] }
          }
        },
        "shot_list": { "enum": ["SUPPORTED", "SUPPORTED_REQUIRES_PROMPT_ALONGSIDE"] },
        "reference_roles": {
          "type": "array",
          "minItems": 2,
          "items": { "enum": ["identity", "face", "garment_detail", "footwear_detail", "hem_detail", "environment_motion"] },
          "description": "`character` is deliberately absent: a real face in a character slot was refused by provider moderation every time, while the same face as a plain image reference passed."
        },
        "audio": { "enum": ["muxed_in_post", "described_in_prompt"] }
      }
    }
  }
}
