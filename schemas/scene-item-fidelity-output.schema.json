{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.local/schemas/scene-item-fidelity-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "verdict",
    "evidence",
    "matching_features",
    "defects",
    "confidence"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "verdict": {
      "enum": ["PASS", "REVISE"]
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "matching_features": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "defects": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
