{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.local/schemas/scene-job.schema.json",
  "title": "Zeely persisted production scene job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "state_revision",
    "request_fingerprint",
    "idempotency_hash",
    "status",
    "phase",
    "message",
    "created_at",
    "updated_at",
    "bindings",
    "delivery",
    "model_route",
    "cycle",
    "manual_retries",
    "retry_requests",
    "attempts",
    "qa",
    "output",
    "error",
    "cancellation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scene_id": { "$ref": "#/$defs/id" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "request_fingerprint": { "$ref": "#/$defs/sha256" },
    "idempotency_hash": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"] },
    "phase": { "type": "string", "minLength": 1, "maxLength": 100 },
    "message": { "type": "string", "maxLength": 500 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "delivery": { "$ref": "#/$defs/delivery" },
    "model_route": { "$ref": "#/$defs/modelRoute" },
    "cycle": { "type": "integer", "minimum": 1 },
    "manual_retries": { "type": "integer", "minimum": 0, "maximum": 20 },
    "retry_requests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/attempt" }
    },
    "qa": { "$ref": "#/$defs/jobQa" },
    "output": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/output" }
      ]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/error" }
      ]
    },
    "cancellation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/cancellation" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "output": { "$ref": "#/$defs/output" },
          "qa": { "$ref": "#/$defs/completedQa" },
          "error": { "type": "null" },
          "cancellation": { "type": "null" }
        }
      },
      "else": { "properties": { "output": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": { "properties": { "error": { "$ref": "#/$defs/error" } } }
    },
    {
      "if": { "properties": { "status": { "const": "CANCELLED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "cancellation": { "$ref": "#/$defs/cancellation" },
          "error": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "width", "height", "media_type", "extension", "color_space"],
      "properties": {
        "aspect_ratio": { "const": "4:5" },
        "width": { "const": 1024 },
        "height": { "const": 1280 },
        "media_type": { "const": "image/png" },
        "extension": { "const": ".png" },
        "color_space": { "const": "srgb" }
      }
    },
    "routeGpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "job_set_type", "model", "model_version", "quality"],
      "properties": {
        "order": { "const": 1 },
        "job_set_type": { "const": "gpt_image_2" },
        "model": { "const": "GPT Image 2" },
        "model_version": { "const": "gpt_image_2" },
        "quality": { "const": "high" }
      }
    },
    "routeNano2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "job_set_type", "model", "model_version", "quality"],
      "properties": {
        "order": { "const": 2 },
        "job_set_type": { "const": "nano_banana_flash" },
        "model": { "const": "Nano Banana 2" },
        "model_version": { "const": "nano_banana_flash" },
        "quality": { "const": "high" }
      }
    },
    "routeNanoPro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "job_set_type", "model", "model_version", "quality"],
      "properties": {
        "order": { "const": 3 },
        "job_set_type": { "const": "nano_banana_2" },
        "model": { "const": "Nano Banana Pro" },
        "model_version": { "const": "nano_banana_2" },
        "quality": { "const": "high" }
      }
    },
    "routeEntry": {
      "oneOf": [
        { "$ref": "#/$defs/routeGpt" },
        { "$ref": "#/$defs/routeNano2" },
        { "$ref": "#/$defs/routeNanoPro" }
      ]
    },
    "modelRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_version", "sha256", "entries"],
      "properties": {
        "route_version": { "const": "zeely.scene.image-route.v1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "entries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/routeGpt" },
            { "$ref": "#/$defs/routeNano2" },
            { "$ref": "#/$defs/routeNanoPro" }
          ],
          "items": false
        }
      }
    },
    "approvedLookBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "look_id",
        "image_sha256",
        "media_type",
        "receipt_sha256",
        "receipt_format",
        "source_run_id",
        "relative_path",
        "receipt_relative_path"
      ],
      "properties": {
        "look_id": { "$ref": "#/$defs/id" },
        "image_sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "enum": ["image/png", "image/jpeg", "image/webp"] },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_format": { "enum": ["APPROVED_LOOK", "RUN_MANIFEST"] },
        "source_run_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/id" }
          ]
        },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "receipt_relative_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "presetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset_id", "version", "sha256", "relative_path"],
      "properties": {
        "preset_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "relative_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "promptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "relative_path"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "relative_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "role", "sha256", "media_type", "not_authority_for", "relative_path"],
      "properties": {
        "reference_id": { "$ref": "#/$defs/id" },
        "role": {
          "enum": [
            "environment_anchor",
            "lighting_anchor",
            "composition_anchor",
            "palette_anchor",
            "negative_reference"
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "enum": ["image/png", "image/jpeg", "image/webp", "application/json"] },
        "not_authority_for": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["identity", "body", "hair", "outfit"] },
          "allOf": [
            { "contains": { "const": "identity" } },
            { "contains": { "const": "body" } },
            { "contains": { "const": "hair" } },
            { "contains": { "const": "outfit" } }
          ]
        },
        "relative_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "referencePackBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_pack_id",
        "version",
        "sha256",
        "relative_path",
        "source_ledger",
        "references"
      ],
      "properties": {
        "reference_pack_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "source_ledger": { "$ref": "https://zeely.ai/schemas/scene-source-ledger.schema.json" },
        "references": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/referenceBinding" }
        }
      }
    },
    "shotAnchorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "role", "reference_id", "sha256", "media_type", "relative_path"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 2 },
        "role": { "enum": ["blocking_topdown", "hero_continuity_anchor"] },
        "reference_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "const": "image/png" },
        "relative_path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_look", "preset", "prompt", "reference_pack"],
      "properties": {
        "approved_look": { "$ref": "#/$defs/approvedLookBinding" },
        "preset": { "$ref": "#/$defs/presetBinding" },
        "prompt": { "$ref": "#/$defs/promptBinding" },
        "reference_pack": { "$ref": "#/$defs/referencePackBinding" },
        "shot_anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/shotAnchorBinding" }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 100 },
        "message": { "type": "string", "maxLength": 500 }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "cancelled_at"],
      "properties": {
        "reason": { "type": "string", "maxLength": 300 },
        "cancelled_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "evidence", "defects"],
      "properties": {
        "id": {
          "enum": [
            "MASTER_LOOK_LOCK",
            "REFERENCE_ROLE_ISOLATION",
            "NEAR_COPY_AND_LEAKAGE",
            "IDENTITY",
            "ITEM_FIDELITY",
            "SCENE_MATCH",
            "LIGHT_AND_CONTACT_SHADOW",
            "FRAMING_AND_ANATOMY",
            "PROVENANCE"
          ]
        },
        "decision": { "enum": ["PASS", "FAIL"] },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "defects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "orderedAttemptGates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "MASTER_LOOK_LOCK" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "REFERENCE_ROLE_ISOLATION" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "NEAR_COPY_AND_LEAKAGE" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "IDENTITY" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "ITEM_FIDELITY" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "SCENE_MATCH" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "LIGHT_AND_CONTACT_SHADOW" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            { "properties": { "id": { "const": "FRAMING_AND_ANATOMY" } } }
          ]
        }
      ],
      "items": false
    },
    "passingAttemptGates": {
      "allOf": [
        { "$ref": "#/$defs/orderedAttemptGates" },
        {
          "contains": {
            "type": "object",
            "required": ["decision"],
            "properties": { "decision": { "const": "FAIL" } }
          },
          "minContains": 0,
          "maxContains": 0
        }
      ]
    },
    "failedAttemptGates": {
      "allOf": [
        { "$ref": "#/$defs/orderedAttemptGates" },
        {
          "contains": {
            "type": "object",
            "required": ["decision"],
            "properties": { "decision": { "const": "FAIL" } }
          },
          "minContains": 1
        }
      ]
    },
    "completedPassingGates": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "MASTER_LOOK_LOCK" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "REFERENCE_ROLE_ISOLATION" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "NEAR_COPY_AND_LEAKAGE" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "IDENTITY" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "ITEM_FIDELITY" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "SCENE_MATCH" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "LIGHT_AND_CONTACT_SHADOW" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "FRAMING_AND_ANATOMY" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/gate" },
            {
              "properties": {
                "id": { "const": "PROVENANCE" },
                "decision": { "const": "PASS" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version", "request_id"],
      "properties": {
        "type": { "enum": ["HUMAN", "MODEL"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "not": { "enum": ["builtin-current", "current", "latest", "unknown"] }
        },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "framingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas_width",
        "canvas_height",
        "subject_bbox_xywh_px",
        "expected_subject_height_percent",
        "subject_height_percent",
        "minimum_clear_space_above_hair_percent",
        "minimum_clear_space_below_footwear_percent",
        "clear_space_above_hair_percent",
        "clear_space_below_footwear_percent",
        "full_head_visible",
        "full_footwear_visible"
      ],
      "properties": {
        "canvas_width": { "const": 1024 },
        "canvas_height": { "const": 1280 },
        "subject_bbox_xywh_px": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "type": "integer", "minimum": 0, "maximum": 1023 },
            { "type": "integer", "minimum": 0, "maximum": 1279 },
            { "type": "integer", "minimum": 1, "maximum": 1024 },
            { "type": "integer", "minimum": 1, "maximum": 1280 }
          ],
          "items": false
        },
        "expected_subject_height_percent": { "const": [74, 78] },
        "subject_height_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "minimum_clear_space_above_hair_percent": { "const": 8 },
        "minimum_clear_space_below_footwear_percent": { "const": 2 },
        "clear_space_above_hair_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "clear_space_above_hair_waived_by_full_head": { "const": false },
        "clear_space_below_footwear_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "full_head_visible": { "type": "boolean" },
        "full_footwear_visible": { "type": "boolean" }
      }
    },
    "passingFramingEvidence": {
      "allOf": [
        { "$ref": "#/$defs/framingEvidence" },
        {
          "properties": {
            "subject_height_percent": { "minimum": 74, "maximum": 78 },
            "clear_space_above_hair_percent": { "minimum": 8 },
            "clear_space_below_footwear_percent": { "minimum": 2 },
            "full_head_visible": { "const": true },
            "full_footwear_visible": { "const": true }
          }
        }
      ]
    },
    "jobQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "gates", "score", "summary"],
      "properties": {
        "decision": { "enum": ["PENDING", "PASS", "FAIL"] },
        "gates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/gate" }
        },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "summary": { "type": "string", "maxLength": 2000 },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "framing_evidence": { "$ref": "#/$defs/framingEvidence" }
      }
    },
    "completedQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "gates", "score", "summary", "reviewer", "framing_evidence"],
      "properties": {
        "decision": { "const": "PASS" },
        "gates": { "$ref": "#/$defs/completedPassingGates" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "summary": { "type": "string", "maxLength": 2000 },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "framing_evidence": { "$ref": "#/$defs/passingFramingEvidence" }
      }
    },
    "promptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "binaryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size", "media_type"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "candidateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size", "media_type", "width", "height"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "media_type": { "const": "image/png" },
        "width": { "const": 1024 },
        "height": { "const": 1280 }
      }
    },
    "providerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "repair_candidate_sha256": ["repair_from_attempt"],
        "repair_from_attempt": ["repair_candidate_sha256"],
        "rejection_id": [
          "rejection_receipt_sha256",
          "rejection_gate_id",
          "supersedes_output_sha256"
        ],
        "rejection_receipt_sha256": [
          "rejection_id",
          "rejection_gate_id",
          "supersedes_output_sha256"
        ],
        "rejection_gate_id": [
          "rejection_id",
          "rejection_receipt_sha256",
          "supersedes_output_sha256"
        ],
        "supersedes_output_sha256": [
          "rejection_id",
          "rejection_receipt_sha256",
          "rejection_gate_id"
        ]
      },
      "properties": {
        "provider": { "type": "string", "maxLength": 300 },
        "provider_request_id": { "type": "string", "maxLength": 300 },
        "request_id": { "type": "string", "maxLength": 300 },
        "job_id": { "type": "string", "maxLength": 300 },
        "model": { "type": "string", "maxLength": 200 },
        "model_version": { "type": "string", "maxLength": 200 },
        "job_set_type": { "type": "string", "maxLength": 200 },
        "quality": { "type": "string", "maxLength": 100 },
        "seed": { "type": ["string", "number", "boolean"] },
        "geometry_strategy": { "type": "string", "maxLength": 200 },
        "geometry_crop_fraction": { "type": "number", "minimum": 0, "maximum": 0.22 },
        "transport_aspect_ratio": { "type": "string", "maxLength": 20 },
        "source_width": { "type": "number", "minimum": 1 },
        "source_height": { "type": "number", "minimum": 1 },
        "source_aspect_ratio": { "type": "string", "maxLength": 20 },
        "raw_output_sha256": { "$ref": "#/$defs/sha256" },
        "geometry_output_sha256": { "$ref": "#/$defs/sha256" },
        "reference_role_order": { "type": "string", "maxLength": 500 },
        "reference_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "attached_reference_count": { "type": "number", "minimum": 1 },
        "structured_reference_count": { "type": "number", "minimum": 0 },
        "shot_anchor_role_order": { "type": "string", "maxLength": 200 },
        "dropped_attachment_roles": { "type": "string", "maxLength": 500 },
        "dropped_attachment_count": { "type": "number", "minimum": 1 },
        "outbound_prompt_sha256": { "$ref": "#/$defs/sha256" },
        "repair_candidate_sha256": { "$ref": "#/$defs/sha256" },
        "repair_from_attempt": { "type": "integer", "minimum": 1 },
        "rejection_id": { "$ref": "#/$defs/id" },
        "rejection_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "rejection_gate_id": {
          "enum": [
            "NEAR_COPY_AND_LEAKAGE",
            "IDENTITY",
            "ITEM_FIDELITY",
            "SCENE_MATCH",
            "LIGHT_AND_CONTACT_SHADOW",
            "FRAMING_AND_ANATOMY"
          ]
        },
        "supersedes_output_sha256": { "$ref": "#/$defs/sha256" },
        "recovered_from_atomic_artifact": { "type": "boolean" }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_width",
        "source_height",
        "target_width",
        "target_height",
        "strategy",
        "color_space",
        "exact_aspect_ratio"
      ],
      "properties": {
        "source_width": { "type": "integer", "minimum": 1 },
        "source_height": { "type": "integer", "minimum": 1 },
        "target_width": { "const": 1024 },
        "target_height": { "const": 1280 },
        "strategy": {
          "enum": ["same_aspect_lossless_resize", "deterministic_bbox_crop"]
        },
        "color_space": { "const": "srgb" },
        "exact_aspect_ratio": { "const": "4:5" },
        "source_attempt": { "type": "integer", "minimum": 1 },
        "source_candidate_sha256": { "$ref": "#/$defs/sha256" },
        "crop_xywh_px": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 0 },
            { "type": "integer", "minimum": 0 },
            { "type": "integer", "minimum": 1, "maximum": 1024 },
            { "type": "integer", "minimum": 1, "maximum": 1280 }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "target_subject_height_percent": { "type": "number", "minimum": 1, "maximum": 100 },
        "output_scale": { "type": "number", "exclusiveMinimum": 1 },
        "trigger_framing_evidence": { "$ref": "#/$defs/framingEvidence" },
        "trigger_reviewer": { "$ref": "#/$defs/reviewer" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "strategy": { "const": "deterministic_bbox_crop" } },
            "required": ["strategy"]
          },
          "then": {
            "required": [
              "source_attempt",
              "source_candidate_sha256",
              "crop_xywh_px",
              "target_subject_height_percent",
              "output_scale",
              "trigger_framing_evidence",
              "trigger_reviewer"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["source_attempt"] },
                { "required": ["source_candidate_sha256"] },
                { "required": ["crop_xywh_px"] },
                { "required": ["target_subject_height_percent"] },
                { "required": ["output_scale"] },
                { "required": ["trigger_framing_evidence"] },
                { "required": ["trigger_reviewer"] }
              ]
            }
          }
        }
      ]
    },
    "attemptQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "gates", "score", "summary", "reviewer", "framing_evidence"],
      "properties": {
        "decision": { "enum": ["PASS", "FAIL"] },
        "gates": { "$ref": "#/$defs/orderedAttemptGates" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "summary": { "type": "string", "maxLength": 2000 },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "framing_evidence": { "$ref": "#/$defs/framingEvidence" }
      }
    },
    "passingAttemptQa": {
      "allOf": [
        { "$ref": "#/$defs/attemptQa" },
        {
          "properties": {
            "decision": { "const": "PASS" },
            "gates": { "$ref": "#/$defs/passingAttemptGates" },
            "framing_evidence": { "$ref": "#/$defs/passingFramingEvidence" }
          }
        }
      ]
    },
    "failedAttemptQa": {
      "allOf": [
        { "$ref": "#/$defs/attemptQa" },
        {
          "properties": {
            "decision": { "const": "FAIL" },
            "gates": { "$ref": "#/$defs/failedAttemptGates" }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "cycle",
        "cycle_attempt",
        "status",
        "route",
        "generation_idempotency_key",
        "started_at",
        "updated_at",
        "compiled_prompt",
        "provider_source",
        "candidate",
        "provider_metadata",
        "normalization",
        "qa_infrastructure_attempts",
        "qa",
        "error"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "cycle": { "type": "integer", "minimum": 1 },
        "cycle_attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "status": {
          "enum": [
            "GENERATING",
            "NORMALIZATION_PENDING",
            "QA_PENDING",
            "GENERATION_FAILED",
            "QA_FAILED",
            "QA_PASS"
          ]
        },
        "route": { "$ref": "#/$defs/routeEntry" },
        "generation_idempotency_key": { "$ref": "#/$defs/sha256" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "compiled_prompt": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/promptArtifact" }
          ]
        },
        "provider_source": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/binaryArtifact" }
          ]
        },
        "candidate": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/candidateArtifact" }
          ]
        },
        "provider_metadata": { "$ref": "#/$defs/providerMetadata" },
        "normalization": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/normalization" }
          ]
        },
        "qa_infrastructure_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "qa": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/attemptQa" }
          ]
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/error" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "QA_PASS" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "qa": { "$ref": "#/$defs/passingAttemptQa" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "QA_FAILED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "qa": { "$ref": "#/$defs/failedAttemptQa" }
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "manifest_relative_path",
        "evidence_manifest_relative_path",
        "qa_receipt_relative_path",
        "privacy_report_relative_path",
        "sha256",
        "manifest_sha256",
        "evidence_manifest_sha256",
        "qa_receipt_sha256",
        "privacy_report_sha256",
        "size",
        "media_type",
        "width",
        "height"
      ],
      "properties": {
        "relative_path": { "const": "outputs/scene.png" },
        "manifest_relative_path": { "const": "outputs/scene-manifest.json" },
        "evidence_manifest_relative_path": { "const": "outputs/scene-evidence-manifest.json" },
        "qa_receipt_relative_path": { "const": "outputs/scene-qa-receipt.json" },
        "privacy_report_relative_path": { "const": "outputs/scene-privacy-report.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "qa_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "privacy_report_sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "media_type": { "const": "image/png" },
        "width": { "const": 1024 },
        "height": { "const": 1280 }
      }
    }
  }
}
