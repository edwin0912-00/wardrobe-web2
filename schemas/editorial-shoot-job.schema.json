{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.local/schemas/editorial-shoot-job.schema.json",
  "title": "Zeely persisted Edwin editorial shoot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shoot_id",
    "state_revision",
    "state_integrity_sha256",
    "request_fingerprint",
    "idempotency_hash",
    "status",
    "phase",
    "message",
    "created_at",
    "updated_at",
    "event_cursor",
    "bindings",
    "bible_approval",
    "hero_approval",
    "retry_requests",
    "shots",
    "cancellation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "shoot_id": { "$ref": "#/$defs/id" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "state_integrity_sha256": { "$ref": "#/$defs/sha256" },
    "request_fingerprint": { "$ref": "#/$defs/sha256" },
    "idempotency_hash": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": [
        "BIBLE_PENDING_APPROVAL",
        "HERO_RUNNING",
        "HERO_PENDING_APPROVAL",
        "SERIES_RUNNING",
        "NEEDS_RETRY",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "phase": { "type": "string", "minLength": 1, "maxLength": 100 },
    "message": { "type": "string", "maxLength": 500 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "event_cursor": { "type": "integer", "minimum": 1 },
    "bindings": { "$ref": "#/$defs/bindings" },
    "bible_approval": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/bibleApproval" }
      ]
    },
    "hero_approval": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/heroApproval" }
      ]
    },
    "retry_requests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/retryRequest" }
    },
    "shots": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/shot" },
            { "properties": { "slot": { "const": "clean_identity_hero" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/shot" },
            { "properties": { "slot": { "const": "environmental_hero" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/shot" },
            { "properties": { "slot": { "const": "sculptural_three_quarter" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/shot" },
            { "properties": { "slot": { "const": "interference_frame" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/shot" },
            { "properties": { "slot": { "const": "material_or_accessory_detail" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/shot" },
            { "properties": { "slot": { "const": "wide_campaign_coda" } } }
          ]
        }
      ],
      "items": false
    },
    "cancellation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/cancellation" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "COMPLETED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "shots": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/shot" },
                { "properties": { "status": { "const": "APPROVED" } } }
              ]
            }
          },
          "cancellation": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "CANCELLED" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "cancellation": { "$ref": "#/$defs/cancellation" } }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "slot": {
      "enum": [
        "clean_identity_hero",
        "environmental_hero",
        "sculptural_three_quarter",
        "interference_frame",
        "material_or_accessory_detail",
        "wide_campaign_coda"
      ]
    },
    "approvedLook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["look_id", "image_sha256", "receipt_sha256"],
      "properties": {
        "look_id": { "$ref": "#/$defs/id" },
        "image_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "shotSpecHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_identity_hero",
        "environmental_hero",
        "sculptural_three_quarter",
        "interference_frame",
        "material_or_accessory_detail",
        "wide_campaign_coda"
      ],
      "properties": {
        "clean_identity_hero": { "$ref": "#/$defs/sha256" },
        "environmental_hero": { "$ref": "#/$defs/sha256" },
        "sculptural_three_quarter": { "$ref": "#/$defs/sha256" },
        "interference_frame": { "$ref": "#/$defs/sha256" },
        "material_or_accessory_detail": { "$ref": "#/$defs/sha256" },
        "wide_campaign_coda": { "$ref": "#/$defs/sha256" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_look", "shoot_bible"],
      "properties": {
        "approved_look": { "$ref": "#/$defs/approvedLook" },
        "shoot_bible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bible_id",
            "mode_id",
            "mode_version",
            "sha256",
            "relative_path",
            "shot_spec_hashes"
          ],
          "properties": {
            "bible_id": { "$ref": "#/$defs/id" },
            "mode_id": {
              "enum": [
                "editorial.edwin_novak.organic_contrast",
                "editorial.edwin_novak.urban_monochrome",
                "editorial.edwin_novak.institutional_modernism",
                "editorial.edwin_novak.luminous_blue_white"
              ]
            },
            "mode_version": { "$ref": "#/$defs/semver" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "relative_path": { "const": "inputs/shoot-bible.json" },
            "shot_spec_hashes": { "$ref": "#/$defs/shotSpecHashes" }
          }
        }
      }
    },
    "bibleApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_hash",
        "bible_sha256",
        "authority",
        "approved_at"
      ],
      "properties": {
        "idempotency_hash": { "$ref": "#/$defs/sha256" },
        "bible_sha256": { "$ref": "#/$defs/sha256" },
        "authority": { "const": "EXPLICIT_API_APPROVAL" },
        "approved_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "heroApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_hash",
        "output_sha256",
        "receipt_sha256",
        "authority",
        "approved_at"
      ],
      "properties": {
        "idempotency_hash": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "authority": { "const": "EXPLICIT_API_APPROVAL" },
        "approved_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "retryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_hash",
        "request_fingerprint",
        "slot",
        "requested_at"
      ],
      "properties": {
        "idempotency_hash": { "$ref": "#/$defs/sha256" },
        "request_fingerprint": { "$ref": "#/$defs/sha256" },
        "slot": { "$ref": "#/$defs/slot" },
        "requested_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "sha256",
        "receipt_sha256",
        "width",
        "height",
        "media_type"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "width": { "const": 1024 },
        "height": { "const": 1280 },
        "media_type": { "const": "image/png" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 100 },
        "message": { "type": "string", "maxLength": 500 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "evidence", "defects"],
      "properties": {
        "id": {
          "enum": [
            "MASTER_LOOK_LOCK",
            "REFERENCE_ROLE_ISOLATION",
            "NEAR_COPY_AND_LEAKAGE",
            "IDENTITY",
            "ITEM_FIDELITY",
            "SCENE_MATCH",
            "LIGHT_AND_CONTACT_SHADOW",
            "FRAMING_AND_ANATOMY",
            "PROVENANCE"
          ]
        },
        "decision": { "enum": ["PASS", "FAIL"] },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "defects": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "PASS" } },
            "required": ["decision"]
          },
          "then": { "properties": { "defects": { "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "decision": { "const": "FAIL" } },
            "required": ["decision"]
          },
          "then": { "properties": { "defects": { "minItems": 1 } } }
        }
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "candidate_sha256",
        "approved_look_sha256",
        "bible_sha256",
        "shot_spec_sha256",
        "gates",
        "reviewer",
        "completed_at"
      ],
      "properties": {
        "decision": { "enum": ["PASS", "FAIL"] },
        "candidate_sha256": { "$ref": "#/$defs/sha256" },
        "approved_look_sha256": { "$ref": "#/$defs/sha256" },
        "bible_sha256": { "$ref": "#/$defs/sha256" },
        "shot_spec_sha256": { "$ref": "#/$defs/sha256" },
        "gates": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "MASTER_LOOK_LOCK" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "REFERENCE_ROLE_ISOLATION" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "NEAR_COPY_AND_LEAKAGE" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "IDENTITY" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "ITEM_FIDELITY" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "SCENE_MATCH" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "LIGHT_AND_CONTACT_SHADOW" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "FRAMING_AND_ANATOMY" } } }] },
            { "allOf": [{ "$ref": "#/$defs/gate" }, { "properties": { "id": { "const": "PROVENANCE" } } }] }
          ],
          "items": false
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "request_id"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "type": "string", "minLength": 1, "maxLength": 200 },
            "request_id": { "$ref": "#/$defs/id" }
          }
        },
        "completed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "operation_id",
        "execution_idempotency_key",
        "status",
        "started_at",
        "completed_at",
        "execution_id",
        "output",
        "qa",
        "error"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "operation_id": { "$ref": "#/$defs/id" },
        "execution_idempotency_key": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["RUNNING", "PASS", "FAIL", "CANCELLED"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/timestamp" }
          ]
        },
        "execution_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/id" }
          ]
        },
        "output": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/output" }
          ]
        },
        "qa": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/qa" }
          ]
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/error" }
          ]
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "owner_pid",
        "owner_process_started_at",
        "operation_id",
        "acquired_at",
        "expires_at"
      ],
      "properties": {
        "owner_id": { "$ref": "#/$defs/id" },
        "owner_pid": { "type": "integer", "minimum": 1 },
        "owner_process_started_at": { "$ref": "#/$defs/timestamp" },
        "operation_id": { "$ref": "#/$defs/id" },
        "acquired_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "status",
        "shot_spec_sha256",
        "retry_count",
        "attempts",
        "output",
        "error",
        "lease"
      ],
      "properties": {
        "slot": { "$ref": "#/$defs/slot" },
        "status": {
          "enum": [
            "BLOCKED",
            "QUEUED",
            "RUNNING",
            "QA_PASSED",
            "APPROVED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "shot_spec_sha256": { "$ref": "#/$defs/sha256" },
        "retry_count": { "type": "integer", "minimum": 0 },
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/attempt" }
        },
        "output": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/output" }
          ]
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/error" }
          ]
        },
        "lease": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/lease" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["QA_PASSED", "APPROVED"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "output": { "$ref": "#/$defs/output" },
              "error": { "type": "null" },
              "lease": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "RUNNING" } },
            "required": ["status"]
          },
          "then": { "properties": { "lease": { "$ref": "#/$defs/lease" } } }
        }
      ]
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "cancelled_at"],
      "properties": {
        "reason": { "type": "string", "maxLength": 300 },
        "cancelled_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
