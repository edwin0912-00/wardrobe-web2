          },
          "then": {
            "properties": {
              "framing_evidence": {
                "$ref": "#/$defs/framingLock/$defs/declared_wide_campaign_coda"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "preset_id": {
                "pattern": "^editorial\\."
              }
            },
            "required": [
              "preset_id"
            ]
          },
          "then": {
            "properties": {
              "preset_id": {
                "pattern": "\\.(clean_identity_hero|environmental_hero|sculptural_three_quarter|interference_frame|material_or_accessory_detail|wide_campaign_coda)$"
              }
            },
            "required": [
              "preset_id"
            ]
          }
        }
      ]
    },
    "assetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "preset_id",
        "sha256",
        "status",
        "framing_evidence",
        "gate_results",
        "named_defects"
      ],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{8,180}$" },
        "preset_id": { "type": "string", "pattern": "^(std|editorial)\\.[a-z0-9._-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["PASS", "FAIL"] },
        "framing_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canvas_width",
            "canvas_height",
            "subject_bbox_xywh_px",
            "expected_subject_height_percent",
            "subject_height_percent",
            "minimum_clear_space_above_hair_percent",
            "minimum_clear_space_below_footwear_percent",
            "clear_space_above_hair_percent",
            "clear_space_below_footwear_percent",
            "full_head_visible",
            "full_footwear_visible"
          ],
          "properties": {
            "canvas_width": { "const": 1536 },
            "canvas_height": { "const": 2048 },
            "subject_bbox_xywh_px": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                { "type": "integer", "minimum": 0, "maximum": 1535 },
                { "type": "integer", "minimum": 0, "maximum": 2047 },
                { "type": "integer", "minimum": 1, "maximum": 1536 },
                { "type": "integer", "minimum": 1, "maximum": 2048 }
              ],
              "items": false
            },
            "expected_subject_height_percent": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "type": "number", "minimum": 0, "maximum": 100 },
                { "type": "number", "minimum": 0, "maximum": 100 }
              ],
              "items": false
            },
            "subject_height_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "subject_height_delivery_tolerance_applied": { "type": "boolean" },
            "minimum_clear_space_above_hair_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "minimum_clear_space_below_footwear_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "clear_space_above_hair_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "clear_space_above_hair_waived_by_full_head": { "type": "boolean" },
            "clear_space_below_footwear_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "full_head_visible": { "type": "boolean" },
            "full_footwear_visible": { "type": "boolean" }
          },
          "allOf": [{ "$ref": "#/$defs/framingLock/$defs/evidenceRows" }]
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gateResult" }
        },
        "named_defects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
          "then": {
            "properties": {
              "framing_evidence": { "$ref": "#/$defs/framingLock/$defs/passingEvidenceRows" }
            }
          }
        },
        { "$ref": "#/$defs/framingLock" }
      ]
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {
          "enum": [
            "MASTER_LOOK_LOCK",
            "REFERENCE_ROLE_ISOLATION",
            "NEAR_COPY_AND_LEAKAGE",
            "IDENTITY",
            "ITEM_FIDELITY",
            "SCENE_MATCH",
            "LIGHT_AND_CONTACT_SHADOW",
            "FRAMING_AND_ANATOMY",
            "PROVENANCE"
          ]
        },
        "status": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
        "evidence": { "type": "string", "minLength": 4 }
      }
    },
    "moodCardGateResults": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "REFERENCE_ROLE_ISOLATION" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "NEAR_COPY_AND_LEAKAGE" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "SCENE_MATCH" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "LIGHT_AND_CONTACT_SHADOW" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "FRAMING_AND_ANATOMY" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "PROVENANCE" } } }] }
      ],
      "items": false
    },
    "productionGateResults": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "MASTER_LOOK_LOCK" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "REFERENCE_ROLE_ISOLATION" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "NEAR_COPY_AND_LEAKAGE" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "IDENTITY" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "ITEM_FIDELITY" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "SCENE_MATCH" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "LIGHT_AND_CONTACT_SHADOW" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "FRAMING_AND_ANATOMY" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateResult" }, { "properties": { "id": { "const": "PROVENANCE" } } }] }
      ],
      "items": false
    }
  }
}
