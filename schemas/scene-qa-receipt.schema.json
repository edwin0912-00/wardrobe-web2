{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.ai/schemas/scene-qa-receipt.schema.json",
  "title": "Zeely Scene QA Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "revision",
    "qa_profile",
    "evidence_subject_sha256",
    "reviewer",
    "verdict",
    "asset_results",
    "completed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{8,180}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "qa_profile": { "enum": ["MOOD_CARD_VISUAL", "PRODUCTION_SCENE"] },
    "evidence_subject_sha256": { "$ref": "#/$defs/sha256" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "enum": ["HUMAN", "MODEL"] },
        "id": { "type": "string", "minLength": 2 },
        "version": {
          "type": "string",
          "minLength": 2,
          "not": { "enum": ["builtin-current", "current", "latest", "unknown"] }
        }
      }
    },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "asset_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assetResult" }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "qa_profile": { "const": "MOOD_CARD_VISUAL" } },
        "required": ["qa_profile"]
      },
      "then": {
        "properties": {
          "asset_results": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/assetResult" },
                {
                  "properties": {
                    "gate_results": { "$ref": "#/$defs/moodCardGateResults" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "qa_profile": { "const": "PRODUCTION_SCENE" } },
        "required": ["qa_profile"]
      },
      "then": {
        "properties": {
          "asset_results": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/assetResult" },
                {
                  "properties": {
                    "gate_results": { "$ref": "#/$defs/productionGateResults" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "PASS" } },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "asset_results": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/assetResult" },
                {
                  "properties": {
                    "status": { "const": "PASS" },
                    "named_defects": { "maxItems": 0 },
                    "gate_results": {
                      "items": {
                        "properties": {
                          "status": { "const": "PASS" }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
