{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrobe:agent-handoff:1.0.0",
  "title": "Wardrobe agent handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "agent_id",
    "branch",
    "base_sha",
    "lease_generation",
    "tested_code_sha",
    "status",
    "summary",
    "changed_paths",
    "pre_change_proof",
    "post_change_proof",
    "adversarial_review",
    "weakened_checks",
    "open_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]{3,4}$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1
    },
    "tested_code_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "status": {
      "enum": [
        "BLOCKED",
        "READY_FOR_REVIEW"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "pre_change_proof": {
      "$ref": "#/$defs/proofArray"
    },
    "post_change_proof": {
      "$ref": "#/$defs/proofArray"
    },
    "adversarial_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "result",
        "reviewer_id",
        "reviewed_code_sha"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "REVISE"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$"
        },
        "reviewed_code_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "weakened_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,119}$"
          },
          "severity": {
            "enum": [
              "INFO",
              "WARNING",
              "BLOCKING"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "$defs": {
    "proofArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "command",
          "result",
          "evidence"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
          },
          "command": {
            "$ref": "#/$defs/argv"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/*?-]+$"
    }
  }
}
