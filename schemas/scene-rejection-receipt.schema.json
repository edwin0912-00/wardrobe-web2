{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.ai/schemas/scene-rejection-receipt.schema.json",
  "title": "Zeely post-release scene rejection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "rejection_id",
    "sequence",
    "scene_id",
    "idempotency_hash",
    "request_fingerprint",
    "decision",
    "gate",
    "reviewer",
    "rejected_release",
    "repair_source",
    "quarantine_relative_path",
    "rejected_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_type": { "const": "POST_RELEASE_SCENE_REJECTION" },
    "rejection_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "scene_id": { "$ref": "#/$defs/id" },
    "idempotency_hash": { "$ref": "#/$defs/sha256" },
    "request_fingerprint": { "$ref": "#/$defs/sha256" },
    "decision": { "const": "REJECTED" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence", "defects"],
      "properties": {
        "id": { "$ref": "#/$defs/visualGate" },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "defects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "rejected_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "cycle", "approved_at", "output"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "cycle": { "type": "integer", "minimum": 1 },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "output": { "$ref": "#/$defs/outputReceipt" }
      }
    },
    "repair_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "media_type",
        "width",
        "height",
        "source_attempt"
      ],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "const": "image/png" },
        "width": { "const": 1024 },
        "height": { "const": 1280 },
        "source_attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "quarantine_relative_path": {
      "type": "string",
      "pattern": "^quarantine/rejections/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "rejected_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "visualGate": {
      "enum": [
        "NEAR_COPY_AND_LEAKAGE",
        "IDENTITY",
        "ITEM_FIDELITY",
        "SCENE_MATCH",
        "LIGHT_AND_CONTACT_SHADOW",
        "FRAMING_AND_ANATOMY"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version", "request_id"],
      "properties": {
        "type": { "enum": ["HUMAN", "MODEL"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "not": { "enum": ["builtin-current", "current", "latest", "unknown"] }
        },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "outputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "manifest_relative_path",
        "evidence_manifest_relative_path",
        "qa_receipt_relative_path",
        "privacy_report_relative_path",
        "sha256",
        "manifest_sha256",
        "evidence_manifest_sha256",
        "qa_receipt_sha256",
        "privacy_report_sha256",
        "size",
        "media_type",
        "width",
        "height"
      ],
      "properties": {
        "relative_path": { "const": "outputs/scene.png" },
        "manifest_relative_path": { "const": "outputs/scene-manifest.json" },
        "evidence_manifest_relative_path": { "const": "outputs/scene-evidence-manifest.json" },
        "qa_receipt_relative_path": { "const": "outputs/scene-qa-receipt.json" },
        "privacy_report_relative_path": { "const": "outputs/scene-privacy-report.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "qa_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "privacy_report_sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 },
        "media_type": { "const": "image/png" },
        "width": { "const": 1024 },
        "height": { "const": 1280 }
      }
    }
  }
}
