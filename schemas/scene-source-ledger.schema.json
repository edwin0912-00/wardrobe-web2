{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.ai/schemas/scene-source-ledger.schema.json",
  "title": "Zeely Scene Release Source Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "revision",
    "preset_id",
    "preset_version",
    "status",
    "sources",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "ledger_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{8,160}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "preset_id": { "type": "string", "pattern": "^(std|editorial)\\.[a-z0-9._-]+$" },
    "preset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "const": "VERIFIED_FOR_RELEASE" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "role",
        "use",
        "not_authority_for",
        "retrieved_at",
        "snapshot_uri",
        "content_sha256",
        "rights"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{4,160}$" },
        "url": { "type": "string", "pattern": "^https://" },
        "role": {
          "enum": [
            "environment_and_composition_inspiration",
            "lighting_composition_palette_inspiration",
            "environment_material_inspiration",
            "editorial_style_observation"
          ]
        },
        "use": { "type": "string", "minLength": 10 },
        "not_authority_for": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "body",
              "hair",
              "outfit",
              "brands",
              "readable_text",
              "exact_architecture"
            ]
          }
        },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "snapshot_uri": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
        },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis",
            "rights_holder",
            "evidence_uri",
            "evidence_sha256",
            "verified_at"
          ],
          "properties": {
            "status": { "const": "VERIFIED" },
            "basis": {
              "enum": [
                "OWNED",
                "LICENSED",
                "WRITTEN_PERMISSION",
                "PUBLIC_DOMAIN"
              ]
            },
            "rights_holder": { "type": "string", "minLength": 2 },
            "evidence_uri": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
            },
            "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "verified_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
