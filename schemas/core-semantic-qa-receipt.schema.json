{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeely.ai/schemas/core-semantic-qa-receipt.schema.json",
  "title": "Core Semantic QA Receipt",
  "description": "Runner-owned, content-addressed semantic QA evidence for conditioning, avatar, and outfit gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "authority",
    "phase",
    "attempt",
    "job_id",
    "run_id",
    "subject",
    "evidence",
    "evaluator",
    "decision",
    "reason",
    "checks",
    "defects",
    "receipt_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_type": { "const": "CORE_SEMANTIC_QA" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "component", "version"],
      "properties": {
        "owner": { "const": "RUNNER" },
        "component": { "const": "PIPELINE_RUNNER" },
        "version": { "const": "1.0.0" }
      }
    },
    "phase": { "$ref": "#/$defs/phase" },
    "attempt": { "type": "integer", "minimum": 0 },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "subject": { "$ref": "#/$defs/subject" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "evaluator": { "$ref": "#/$defs/evaluator" },
    "decision": { "enum": ["PASS", "RETRY", "NEEDS_INPUT", "REJECT"] },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "defects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "receipt_id": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "PASS" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "checks": {
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/check" },
                {
                  "properties": {
                    "required": { "const": true },
                    "pass": { "const": true }
                  }
                }
              ]
            }
          },
          "defects": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "enum": ["conditioning", "avatar", "outfit"]
    },
    "exactText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "attestedMetadata": {
      "allOf": [
        { "$ref": "#/$defs/exactText" },
        {
          "not": {
            "pattern": "(?:^|[._\\s/@+\\-])(?:[Ll][Aa][Tt][Ee][Ss][Tt]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Aa][Tt][Tt][Ee][Ss][Tt][Ee][Dd])(?:$|[._\\s/@+\\-])"
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "media_type"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "role", "sha256"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "reference_pack_sha256": { "$ref": "#/$defs/sha256" },
        "facts_sha256": { "$ref": "#/$defs/sha256" },
        "prepared_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "phase",
        "attempt",
        "job_hash",
        "execution_hash",
        "subject",
        "prompt_sha256",
        "bindings",
        "manifest_sha256"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "phase": { "$ref": "#/$defs/phase" },
        "attempt": { "type": "integer", "minimum": 0 },
        "job_hash": { "$ref": "#/$defs/sha256" },
        "execution_hash": { "$ref": "#/$defs/sha256" },
        "subject": { "$ref": "#/$defs/subject" },
        "prompt_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding" }
        },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider", "model", "version", "evaluation_id"],
      "properties": {
        "type": {
          "enum": ["MODEL", "FIXTURE", "REPLAY", "ADAPTER", "IMPORTED_RECEIPT"]
        },
        "provider": { "$ref": "#/$defs/attestedMetadata" },
        "model": { "$ref": "#/$defs/attestedMetadata" },
        "version": { "$ref": "#/$defs/attestedMetadata" },
        "evaluation_id": { "$ref": "#/$defs/sha256" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "pass", "score", "evidence"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "required": { "const": true },
        "pass": { "type": "boolean" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    }
  }
}
